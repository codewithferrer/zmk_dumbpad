#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/zmk/hid_indicators.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <5>;
        rows = <4>;

        map = <
RC(0,1) RC(0,2) RC(0,3) RC(0,4)
RC(1,1) RC(1,2) RC(1,3) RC(1,4)
RC(2,1) RC(2,2) RC(2,3) RC(2,4)
RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";

        diode-direction = "col2row";
        // TEST: row 1 (2nd entry) moved from pro_micro 20 (F5) to pro_micro 10
        // (B6) -- the exact pin used for the original bypass on the old PCB.
        // F5 and D0 both checked out electrically but the matrix scan never
        // registered either; trying a pin with a known-good track record.
        // NOTE: pro_micro 10 is normally the right status LED -- moved to
        // pro_micro 1 below to avoid the conflict while testing this.
        row-gpios
            = <&pro_micro 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 18 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };

    left_encoder: encoder_left {
        compatible = "alps,ec11";
        label = "LEFT_ENCODER";
        a-gpios = <&pro_micro 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&pro_micro 16 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        resolution = <2>;
        status = "disabled";
    };

    sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder>;
    };

    // v1.1 PCB status LEDs (right/center/left, QMK LED_00/LED_01/LED_02).
    // Pin numbers derived from the original ATmega32u4 pin assignment
    // (B6/B1/B3) via the standard pro_micro numbering already used above.
    leds {
        compatible = "gpio-leds";

        // TEST: moved from pro_micro 10 to pro_micro 1 -- pin 10 (B6) is
        // being reused for the row-1 bypass test above.
        led_right: led_right {
            gpios = <&pro_micro 1 GPIO_ACTIVE_HIGH>;
        };

        led_center: led_center {
            gpios = <&pro_micro 15 GPIO_ACTIVE_HIGH>;
        };

        led_left: led_left {
            gpios = <&pro_micro 14 GPIO_ACTIVE_HIGH>;
        };
    };

    // TEST: forced always-on (both brightness levels =100, plus while
    // disconnected) regardless of indicator state, just to check the 3 LEDs
    // physically light up. To restore: delete the 2 added lines in each
    // node below (inactive-brightness / disconnected-brightness).
    indicators {
        compatible = "zmk,indicator-leds";

        num_lock_indicator: num_lock_indicator {
            indicator = <HID_INDICATOR_NUM_LOCK>;
            leds = <&led_right>;
            on-while-idle;
            inactive-brightness = <100>;
            disconnected-brightness = <100>;
        };

        scroll_lock_indicator: scroll_lock_indicator {
            indicator = <HID_INDICATOR_SCROLL_LOCK>;
            leds = <&led_center>;
            on-while-idle;
            inactive-brightness = <100>;
            disconnected-brightness = <100>;
        };

        caps_lock_indicator: caps_lock_indicator {
            indicator = <HID_INDICATOR_CAPS_LOCK>;
            leds = <&led_left>;
            on-while-idle;
            inactive-brightness = <100>;
            disconnected-brightness = <100>;
        };
    };
};