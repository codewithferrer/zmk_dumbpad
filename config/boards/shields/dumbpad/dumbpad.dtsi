#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/zmk/hid_indicators.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <5>;
        rows = <4>;

        map = <
RC(0,1) RC(0,2) RC(0,3) RC(0,4)
RC(1,1) RC(1,2) RC(1,3) RC(1,4)
RC(2,1) RC(2,2) RC(2,3) RC(2,4)
RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";

        diode-direction = "col2row";
        row-gpios
            = <&pro_micro 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 18 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };

    left_encoder: encoder_left {
        compatible = "alps,ec11";
        label = "LEFT_ENCODER";
        a-gpios = <&pro_micro 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&pro_micro 16 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        resolution = <2>;
        status = "disabled";
    };

    sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder>;
    };

    // v1.1 PCB status LEDs (right/center/left, QMK LED_00/LED_01/LED_02).
    // Pin numbers derived from the original ATmega32u4 pin assignment
    // (B6/B1/B3) via the standard pro_micro numbering already used above.
    leds {
        compatible = "gpio-leds";

        led_right: led_right {
            gpios = <&pro_micro 10 GPIO_ACTIVE_HIGH>;
        };

        led_center: led_center {
            gpios = <&pro_micro 15 GPIO_ACTIVE_HIGH>;
        };

        led_left: led_left {
            gpios = <&pro_micro 14 GPIO_ACTIVE_HIGH>;
        };
    };

    indicators {
        compatible = "zmk,indicator-leds";

        num_lock_indicator: num_lock_indicator {
            indicator = <HID_INDICATOR_NUM_LOCK>;
            leds = <&led_right>;
            on-while-idle;
        };

        scroll_lock_indicator: scroll_lock_indicator {
            indicator = <HID_INDICATOR_SCROLL_LOCK>;
            leds = <&led_center>;
            on-while-idle;
        };

        caps_lock_indicator: caps_lock_indicator {
            indicator = <HID_INDICATOR_CAPS_LOCK>;
            leds = <&led_left>;
            on-while-idle;
        };
    };
};