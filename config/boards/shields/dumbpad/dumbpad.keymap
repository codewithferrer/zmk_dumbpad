                        , <&macro_tap &kp C>
                        , <&macro_tap &kp T>
                        , <&macro_tap &kp SPACE>
                        , <&macro_tap &kp AT>
                        , <&macro_tap &kp S>
                        , <&macro_tap &kp SPACE>
                        , <&macro_tap &kp F>
                        , <&macro_tap &kp I>
                        , <&macro_tap &kp R>
                        , <&macro_tap &kp E>
