#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/*
 * TEMPORARY KEY-TEST KEYMAP ACTIVE BELOW -- this is the real config, kept
 * here commented out so it's a single copy/paste to restore. To go back:
 * delete everything from the "TEST KEYMAP" block down to the end of the
 * file, then remove this opening comment marker and its closing pair below.

/ {

        macros {
              // Cmd+K (switch conversation) then type a pinned project name, then Enter.
              // Replace the typed letters below with your real project name before flashing.
              claude_proj_a: claude_proj_a {
                label = "ZM_CLAUDE_PROJECT_A";
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                wait-ms = <30>;
                tap-ms = <10>;
                bindings
                        = <&macro_tap &kp LG(K)>
                        , <&macro_tap &kp P>
                        , <&macro_tap &kp R>
                        , <&macro_tap &kp O>
                        , <&macro_tap &kp J>
                        , <&macro_tap &kp E>
                        , <&macro_tap &kp C>
                        , <&macro_tap &kp T>
                        , <&macro_tap &kp SPACE>
                        , <&macro_tap &kp A>
                        , <&macro_tap &kp RET>
                        ;
              };

              claude_proj_b: claude_proj_b {
                label = "ZM_CLAUDE_PROJECT_B";
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                wait-ms = <30>;
                tap-ms = <10>;
                bindings
                        = <&macro_tap &kp LG(K)>
                        , <&macro_tap &kp P>
                        , <&macro_tap &kp R>
                        , <&macro_tap &kp O>
                        , <&macro_tap &kp J>
                        , <&macro_tap &kp E>
                        , <&macro_tap &kp C>
                        , <&macro_tap &kp T>
                        , <&macro_tap &kp SPACE>
                        , <&macro_tap &kp B>
                        , <&macro_tap &kp RET>
                        ;
              };

              claude_proj_c: claude_proj_c {
                label = "ZM_CLAUDE_PROJECT_C";
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                wait-ms = <30>;
                tap-ms = <10>;
                bindings
                        = <&macro_tap &kp LG(K)>
                        , <&macro_tap &kp P>
                        , <&macro_tap &kp R>
                        , <&macro_tap &kp O>
                        , <&macro_tap &kp J>
                        , <&macro_tap &kp E>
                        , <&macro_tap &kp C>
                        , <&macro_tap &kp T>
                        , <&macro_tap &kp SPACE>
                        , <&macro_tap &kp C>
                        , <&macro_tap &kp RET>
                        ;
              };

              claude_proj_d: claude_proj_d {
                label = "ZM_CLAUDE_PROJECT_D";
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                wait-ms = <30>;
                tap-ms = <10>;
                bindings
                        = <&macro_tap &kp LG(K)>
                        , <&macro_tap &kp P>
                        , <&macro_tap &kp R>
                        , <&macro_tap &kp O>
                        , <&macro_tap &kp J>
                        , <&macro_tap &kp E>
                        , <&macro_tap &kp C>
                        , <&macro_tap &kp T>
                        , <&macro_tap &kp SPACE>
                        , <&macro_tap &kp D>
                        , <&macro_tap &kp RET>
                        ;
              };

        };


    keymap {
        compatible = "zmk,keymap";

        default_layer {
// -------------------------------------------------------------------
// | QUICK   | VOICE    | NEW CHAT | STOP        |
// | SEARCH  | SIDEBAR  | PROJ A   | PROJ B      |
// | SEND    | CODE: 1  | CODE: 2  | ZOOM IN     |
// | SEND*   | ZOOM OUT | CODE: 3  | PROJ C | PROJ D
// -------------------------------------------------------------------
// QUICK/VOICE send F19/F20 -- bind those as the Custom "Quick access"
// and "Voice" shortcuts in Claude Desktop (Settings > Desktop app > General).
// CODE: 1/2/3 send the digit keys Claude Code's permission prompts read
// directly (Deny/Allow once/Allow always -- the exact action per digit
// shifts depending on how many options the prompt shows, so these just
// press the position, same as typing 1/2/3 on a regular keyboard).
// ZOOM IN/OUT (Cmd +/-) are confirmed Claude Desktop shortcuts.
// SEND* is the encoder's push-button (this PCB's combo Cherry MX/EC11 socket
// wires the encoder click into the matrix as this key) -- pairs with the
// encoder's scroll-conversation rotation below: rotate to read, click to send.
            bindings = <
                &kp F19    &kp F20        &kp LG(O)       &kp ESC
                &kp LG(K)  &kp LG(LS(S))  &claude_proj_a  &claude_proj_b
                &kp RET    &kp N1         &kp N2          &kp LG(EQUAL)
    &kp RET  &kp LG(MINUS)  &kp N3  &claude_proj_c  &claude_proj_d
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PG_DN>;
        };
    };
};

 * END OF REAL CONFIG -- TEST KEYMAP BELOW IS THE ACTIVE ONE
 */

// TEST KEYMAP: one letter per physical key (A-Q, reading order: row0 -> row3,
// left to right), so each key can be identified by typing into a text field
// and checking which letter appears. Encoder rotation sends X (clockwise) /
// Y (counter-clockwise); the encoder's push-button is key M (row3, pos0).
/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
// -------------------------
// |  A  |  B  |  C  |  D  |
// |  E  |  F  |  G  |  H  |
// |  I  |  J  |  K  |  L  |
// | M*  |  N  |  O  |  P  | Q
// -------------------------
// M* is the encoder's push-button. Encoder rotation: X clockwise, Y counter-
// clockwise (see sensor-bindings below).
            bindings = <
                &kp A  &kp B  &kp C  &kp D
                &kp E  &kp F  &kp G  &kp H
                &kp I  &kp J  &kp K  &kp L
    &kp M  &kp N  &kp O  &kp P  &kp Q
            >;

            sensor-bindings = <&inc_dec_kp X Y>;
        };
    };
};
