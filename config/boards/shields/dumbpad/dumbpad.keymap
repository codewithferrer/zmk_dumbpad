    keymap {
        compatible = "zmk,keymap";

        default_layer {
// -----------------------------------------------------------------------
// | GM CREATIVE  | GM SURVIVAL | GM SPECTATE  | DIFF PEACE    |
// | TIME DAY     | TIME NIGHT  | WEATHER CLR  | WEATHER THNDR |
// | NIGHT VISION | KILL HOSTILE| TP ALL TO ME | FX SPEED      |
// | CHAT (T)*    | FX JUMP     | LIGHTNING    | TP UP   | FIRE RESIST
// -----------------------------------------------------------------------
// The 4 gamemode/difficulty keys (CREATIVE/SURVIVAL/SPECTATE/DIFF PEACE)
// are grouped in row 0; the 4 time/weather keys are grouped in row 1.
// KILL HOSTILE only targets hostile mobs (@e[family=monster]). TP ALL TO
// ME teleports every player to you (@a to @s) -- handy for gathering the
// group, and doubles as a prank.
// Every key except CHAT is a macro: "/" (opens chat pre-filled with the
// command prefix) + the rest of the command text + Enter.
// CHAT* is the encoder's push-button (this PCB's combo Cherry MX/EC11
// socket wires the encoder click into the matrix as this key) -- sends
// plain "T" to open chat for a normal (non-command) message.
// Encoder rotation scrolls the chat history (Page Up/Down).
            bindings = <
                &mc_gm_creative   &mc_gm_survival   &mc_gm_spectator  &mc_difficulty_peaceful
                &mc_time_day      &mc_time_night        &mc_weather_clear &mc_weather_thunder
                &mc_night_vision  &mc_kill_hostile  &mc_tp_all_to_me    &mc_effect_speed
    &kp T  &mc_effect_jump  &mc_summon_lightning  &mc_tp_up  &mc_fire_resistance
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PG_DN>;
        };
    };
};
