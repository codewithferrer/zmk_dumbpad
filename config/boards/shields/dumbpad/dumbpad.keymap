                        , <&macro_tap &kp M>
                        , <&macro_tap &kp E>
                        , <&macro_tap &kp M>
                        , <&macro_tap &kp O>
                        , <&macro_tap &kp D>
                        , <&macro_tap &kp E>
                        , <&macro_tap &kp SPACE>
                        , <&macro_tap &kp S>
                        , <&macro_tap &kp U>
                        , <&macro_tap &kp R>
                        , <&macro_tap &kp V>
                        , <&macro_tap &kp I>
                        , <&macro_tap &kp V>
                        , <&macro_tap &kp A>
                        , <&macro_tap &kp L>
                        , <&macro_tap &kp RET>
                        ;
              };

