                        , <&macro_tap &kp F>
                        , <&macro_tap &kp E>
                        , <&macro_tap &kp C>
                        , <&macro_tap &kp T>
                        , <&macro_tap &kp SPACE>
                        , <&macro_tap &kp AT>
