                        , <&macro_tap &kp R>
                        , <&macro_tap &kp E>
                        , <&macro_tap &kp S>
                        , <&macro_tap &kp I>
                        , <&macro_tap &kp S>
                        , <&macro_tap &kp T>
                        , <&macro_tap &kp A>
