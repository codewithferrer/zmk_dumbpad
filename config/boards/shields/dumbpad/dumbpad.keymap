// Minecraft (Bedrock, Nintendo Switch) command pad. Single layer, no Claude
// bindings -- the Claude Desktop control-surface keymap is parked, still
// available in git history at commit bdd6a78 if you want it back later.
//
// Requires a wired USB connection (via the Switch dock's USB-A port, or a
// USB-C-to-A adapter) -- Switch's own USB-C port isn't a host port in
// handheld mode, and Bluetooth keyboards are unreliable on Switch.
//
// Every command key: presses "/" (opens Minecraft's chat box pre-filled with
// "/"), types the rest of the command, then Enter to send. The bottom-left
// key (the encoder's push-button) instead sends plain "T", which opens chat
// for a normal (non-command) message.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {

        macros {
              mc_gm_creative: mc_gm_creative {
                label = "ZM_MC_GM_CREATIVE";
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                wait-ms = <20>;
                tap-ms = <10>;
                bindings
                        = <&macro_tap &kp FSLH>
                        , <&macro_tap &kp G>
                        , <&macro_tap &kp A>
                        , <&macro_tap &kp M>
                        , <&macro_tap &kp E>
                        , <&macro_tap &kp M>
                        , <&macro_tap &kp O>
                        , <&macro_tap &kp D>
                        , <&macro_tap &kp E>
                        , <&macro_tap &kp SPACE>
                        , <&macro_tap &kp C>
                        , <&macro_tap &kp R>
                        , <&macro_tap &kp E>
                        , <&macro_tap &kp A>
                        , <&macro_tap &kp T>
                        , <&macro_tap &kp I>
                        , <&macro_tap &kp V>
                        , <&macro_tap &kp E>
                        , <&macro_tap &kp RET>
                        ;
              };

